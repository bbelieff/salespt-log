# ── Auth (Google OAuth) ───────────────────────────────
AUTH_SECRET="openssl rand -base64 32 로 생성"
AUTH_URL="http://localhost:3000"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ── Google Sheets ────────────────────────────────────
# 서비스 계정 JSON의 내용을 한 줄로 넣거나, 파일 경로를 주고 런타임에 읽는다.
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=""

# 수강생→시트 매핑을 저장할 마스터 레지스트리 시트 ID (사용자 선택)
SHEETS_REGISTRY_ID=""
SHEETS_REGISTRY_TAB="users"

# ── 관리자 Drive 생성 토큰 (선택, ADR-0015) ───────────
# SA 는 Drive 용량 0 → My-Drive 공유 폴더에 시트/폴더를 만들 수 없음.
# 아레나 일괄 생성(복제·폴더생성)을 belie OAuth 로 수행하려면 설정.
# 발급: node scripts/get-admin-drive-token.mjs (scope=drive, offline). 비우면 SA 폴백.
ADMIN_DRIVE_REFRESH_TOKEN=""

# ── Analytics (선택) ──────────────────────────────────
# 설정 시 GA4 스크립트가 자동 로드됨. 비워두면 비활성 (dev/local 권장).
NEXT_PUBLIC_GA_ID=""

# ── Error Monitoring (Sentry) ─────────────────────────
# DSN 은 공개해도 안전 (브라우저 번들에 포함됨). 비우면 자동 비활성.
NEXT_PUBLIC_SENTRY_DSN=""
# (선택) 소스맵 업로드용 — Sentry > Settings > Auth Tokens 에서 발급
SENTRY_AUTH_TOKEN=""

# ── Product Analytics (PostHog) ───────────────────────
# 운영(배포)에서만 동작 (NODE_ENV=production + 키 존재). 로컬은 비우면 자동 비활성.
# KEY 는 공개 클라이언트 키(phc_...) — 브라우저 번들에 포함됨(안전).
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# ── 사용 가이드 / 새소식 링크 (선택, inapp-guide-link) ──────────────────
# 사용법 게시판 공개 URL. 설정 시 공지팝업·새소식 보관함·상단 메뉴에 '사용 가이드' 진입점
# 노출(빌드 인라인). 비우면 버튼 자동 숨김.
# 운영값 공급원 = **GitHub Variables `NEXT_PUBLIC_GUIDE_URL`** → deploy.yml 주입 스텝이 VPS
# .env 에 반영(2026-07-20, 네이버카페 사용법게시판으로 전환). 값 변경 = Variables 갱신 + 재배포 1회.
NEXT_PUBLIC_GUIDE_URL=""
